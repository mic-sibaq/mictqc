# Set these in Vercel Project > Settings > Environment Variables.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Store the PRIVATE KEY as one value. In Vercel, paste the key including BEGIN/END lines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_spreadsheet_id
GOOGLE_DRIVE_FOLDER_ID=your_private_drive_folder_id
ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional: share uploaded files with this organizer email so the admin can review them.
ADMIN_EMAIL=organizer@example.com
